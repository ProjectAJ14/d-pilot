meta {
  name: Create Connection
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/settings/connections
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "qa-pg",
    "name": "QA PostgreSQL",
    "env": "QA",
    "type": "postgres",
    "host": "localhost",
    "port": 5432,
    "database": "app_core",
    "username": "dpilot",
    "password": "",
    "schema": "public"
  }
}

docs {
  Add a connection. `type` is postgres | mssql | mongodb | elasticsearch; `env` is free-form (a new name adds an environment — production rails apply to any name containing "prod"). MongoDB uses `uri`. Password and URI are encrypted at rest. 409 if the id exists. Audited as `CONNECTION_CREATE`. Test it with Connections / Test Connection.

  Requires a valid Bearer JWT ({{token}}).
  **Admin only.**
}
