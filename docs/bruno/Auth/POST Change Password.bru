meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "changeme123",
    "newPassword": "newpassword123"
  }
}

docs {
  Change your own password. New password must be at least 8 characters.

  Requires a valid Bearer JWT ({{token}}).
}
