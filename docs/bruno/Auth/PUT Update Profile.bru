meta {
  name: Update Profile
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/auth/profile
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "displayName": "Jane Doe"
  }
}

docs {
  Update your own display name.

  Requires a valid Bearer JWT ({{token}}).
}
