meta {
  name: Table Columns
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/schema/{{connectionId}}/tables/{{tableName}}/columns
  body: none
  auth: inherit
}

params:query {
  ~schema: public
}

docs {
  Columns for a specific table.

  Requires a valid Bearer JWT ({{token}}).

  Errors: 503 { error, code: "CONNECTION_FAILED" } when the database host is
  unreachable (network); 500 { error } for other introspection failures.
}
