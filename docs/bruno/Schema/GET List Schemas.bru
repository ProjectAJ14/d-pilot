meta {
  name: List Schemas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/schema/{{connectionId}}/schemas
  body: none
  auth: inherit
}

docs {
  Available schemas for the connection (Postgres/MSSQL). Empty for Mongo/ES.

  Requires a valid Bearer JWT ({{token}}).

  Errors: 503 { error, code: "CONNECTION_FAILED" } when the database host is
  unreachable (network); 500 { error } for other introspection failures.
}
