meta {
  name: Full Schema
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/schema/{{connectionId}}/full
  body: none
  auth: inherit
}

params:query {
  ~schema: public
}

docs {
  Cached full schema (all tables + columns) for a connection, used by editor autocomplete.

  Requires a valid Bearer JWT ({{token}}).

  Errors: 503 { error, code: "CONNECTION_FAILED" } when the database host is
  unreachable (network); 500 { error } for other introspection failures.
}
