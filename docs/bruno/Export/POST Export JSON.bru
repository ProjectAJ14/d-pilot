meta {
  name: Export JSON
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/export/json
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-PHI-Shield: off
  ~X-PHI-Unmask-Reason: Investigating a data issue
  ~X-PHI-Unmask-Notes: ticket OPP-000
}

body:json {
  {
    "connectionId": "{{connectionId}}",
    "sql": "SELECT 1"
  }
}

docs {
  Run a read-only query and download the masked results as JSON.

  Requires a valid Bearer JWT ({{token}}) plus **read** capability for the connection's environment — 403 otherwise (admins hold every environment).
  Supports PHI unmask headers (disabled by default; enable to reveal PHI where permitted).
}
