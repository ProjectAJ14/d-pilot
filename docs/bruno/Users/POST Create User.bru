meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "user@example.com",
    "displayName": "New User",
    "password": "changeme123",
    "isAdmin": false,
    "allowedEnvironments": [
      "DEV",
      "QA"
    ],
    "unmaskEnvironments": [],
    "writeEnvironments": [
      "DEV"
    ],
    "approveEnvironments": []
  }
}

docs {
  Create a user. Admin implies all capabilities; otherwise supply per-env lists.

  Environment names outside this deployment's set (see `GET /api/config` →
  `environments`) are silently dropped from every capability list.

  Requires a valid Bearer JWT ({{token}}).
  **Admin only.**
}
