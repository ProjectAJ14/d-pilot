meta {
  name: Reset User Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/users/{{userId}}/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newPassword": "newpassword123"
  }
}

docs {
  Reset another user's password (min 8 characters).

  Requires a valid Bearer JWT ({{token}}).
  **Admin only.**
}
