meta {
  name: Cancel Write Request
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/write-requests/{{writeRequestId}}/cancel
  body: none
  auth: inherit
}

docs {
  Withdraw your own PENDING/DRAFT request.

  409 if the request is no longer PENDING/DRAFT — including one a direct-write environment is running right now; it is never overwritten with CANCELLED.

  Requires a valid Bearer JWT ({{token}}).
}
