meta {
  name: Set Masked Environments
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/phi-config/masked-envs
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "environments": [
      "DEV",
      "QA",
      "UAT",
      "STG",
      "PROD"
    ]
  }
}

docs {
  Set the masked-environment list. PROD must remain present (422 otherwise).

  Values must be environments this deployment actually has (see `GET /api/config`
  → `environments`); anything else is a 400 that names the allowed values.

  Requires a valid Bearer JWT ({{token}}).
  **Admin only.**
}
