meta {
  name: Update PHI Rule
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/phi-config/{{phiRuleId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pattern": "ssn",
    "maskingType": "PARTIAL",
    "alwaysMasked": true,
    "database": null,
    "table": null
  }
}

docs {
  Update a PHI masking rule.

  Requires a valid Bearer JWT ({{token}}).
  **Admin only.**
}
