meta {
  name: Get Masked Environments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/phi-config/masked-envs
  body: none
  auth: inherit
}

docs {
  Environments where PHI is tokenized. Every production-like environment (any
  name containing "prod") is always included, whatever the stored setting says.

  Requires a valid Bearer JWT ({{token}}).
}
