# D-Pilot Configuration
# Copy to .env and fill in values.
#
# Database connections and the AI assistant (Azure OpenAI) are configured
# in-app only, under Settings — they have no env var here.
#
#   1. Bootstrap (env only) — needed before the app database exists, or baked
#      into the client build. Change them here and restart (BASE_PATH: rebuild).
#   2. Initial values / fallbacks — branding and limits an admin can override
#      in Settings. Precedence: saved in Settings > .env > built-in default.
#      "Reset" in Settings drops the saved value so .env applies again.

# ============================================================================
# 1. Bootstrap (env only)
# ============================================================================

# Server
PORT=3101
VITE_PORT=3100
NODE_ENV=development

# Sub-path to serve the app under. Leave unset (or "/") when D-Pilot owns a
# domain or subdomain of its own — the normal case. Set it only when a reverse
# proxy mounts D-Pilot under a prefix of a shared domain, e.g. BASE_PATH=/d-pilot
# for https://intranet.example/d-pilot.
#
# It is read at BUILD time by Vite (baked into every asset URL) and at RUN time
# by Express (which mounts itself there), so `npm run build` and `npm start` must
# see the SAME value — changing it means rebuilding, not just restarting. The
# proxy then needs no path rewriting at all. See README, "Serving under a
# sub-path".
# BASE_PATH=/d-pilot

# Where the app database (dbpilot.sqlite, audit_archive.sqlite) and the
# generated settings.key live. Default: ./data
# DATA_DIR=data

# Encrypts secrets stored in the app database (connection passwords / URIs,
# AZURE_OPENAI_KEY) with AES-256-GCM. Any string. If unset, a random key is
# generated once into DATA_DIR/settings.key (mode 0600). Back that file up WITH
# the database but store it SEPARATELY — whoever holds both can read every
# stored secret, and losing the key means re-entering every secret in Settings.
# SETTINGS_ENCRYPTION_KEY=

# JWT Auth
JWT_SECRET=change-this-to-a-secure-random-string

# Default admin password (used only when seeding the first admin user)
DEFAULT_ADMIN_PASSWORD=changeme123

# Outbound proxy for the Azure OpenAI call, if your network needs one.
# HTTPS_PROXY=http://proxy.example:8080
# HTTP_PROXY=http://proxy.example:8080

# Operator ceilings for the limits below. Each can only LOWER the built-in cap
# (the values shown); an admin cannot save more in Settings, and a saved, .env
# or default value above it is clamped. A value above the built-in cap, zero or
# not a number is ignored with a warning.
# MAX_ROWS_LIMIT=1000000
# MCP_MAX_ROWS_LIMIT=1000000
# QUERY_TIMEOUT_MS_LIMIT=2147483647
# SCHEMA_CACHE_TTL_HOURS_LIMIT=8760

# ============================================================================
# 2. Initial values / fallbacks (overridden by Settings)
# ============================================================================

# Branding
APP_NAME=D-Pilot
# Logo URL — local path (place file in public/) or external URL. Leave empty for text-only header.
LOGO_URL=/logo/logo.png
LIGHT_LOGO_URL=/logo/logo-light.png
FAVICON_URL=/logo/favicon.ico

# Email Domain (used for default admin seed and user creation validation)
EMAIL_DOMAIN=example.com

# Session length for new logins
JWT_EXPIRES_IN=24h

# Query Safety
MAX_ROWS=10000
QUERY_TIMEOUT_MS=30000

# Results "Copy as" formats (optional). JSON array of copy formats offered in the
# results grid's "Copy as" menu and the per-column right-click menu. Leave unset
# for the built-in defaults (CSV, TSV, JSON, Markdown, SQL INSERT, comma,
# single-quoted, double-quoted).
# Each entry has: id, label, optional group/example, optional columnMenu (also
# show on the per-column menu), and EITHER `builtin`
# ("csv"|"tsv"|"json"|"markdown"|"sql-insert") OR a `template`:
#   { columnSeparator, rowSeparator, quote: "none"|"single"|"double",
#     quoteFirstColumn, nullText, header, prefix, suffix }
# Example — comma columns, space rows, values single-quoted:
# COPY_FORMATS='[{"id":"in-clause","label":"SQL IN","group":"List / SQL","columnMenu":true,"template":{"columnSeparator":",","rowSeparator":",","quote":"single","prefix":"IN (","suffix":")"}}]'

# MCP endpoint (/api/mcp) — rows returned per AI-agent query; agents may raise per call
MCP_MAX_ROWS=1000

# Origin users browse D-Pilot on. Only used to build clickable artifact links in
# MCP tool output — without it agents hand back a bare /artifacts/<id> path.
# Set the origin only: BASE_PATH is appended automatically, so a sub-path
# deployment wants APP_BASE_URL=https://intranet.example with BASE_PATH=/d-pilot,
# not the two spliced together by hand.
# APP_BASE_URL=https://d-pilot.internal

# How long (hours) to cache a connection's introspected schema (autocomplete
# and AI query generation). Schema rarely changes; caching avoids re-introspecting the DB on
# every request. Default 24. Set 0 to disable caching.
# SCHEMA_CACHE_TTL_HOURS=24
