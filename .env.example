# BG D-Pilot Configuration
# Copy to .env and fill in values

# Server
PORT=3101
VITE_PORT=3100
NODE_ENV=development

# JWT Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# Database Connections (JSON array)
# Each connection: { id, name, env, type, host, port, database, username, password, schema? }
# Types: postgres, mssql, mongodb, elasticsearch
# Envs: DEV, QA, UAT, STG, PROD by default. `env` is free-form — use any name you
#   like (e.g. SUPER_PROD) and it appears everywhere on its own: the connection
#   tree, the four capability pickers in User Management, PHI masked-envs and the
#   write policy. Custom names sort after PROD (treated as most sensitive). The
#   PROD safety rails (always tokenized, always two-person writes) apply to the
#   env literally named PROD.
DBFORGE_CONNECTIONS='[
  {
    "id": "dev-pg",
    "name": "Dev PostgreSQL",
    "env": "DEV",
    "type": "postgres",
    "host": "localhost",
    "port": 5432,
    "database": "mydb",
    "username": "",
    "password": "",
    "schema": "public"
  },
  {
    "id": "dev-mssql",
    "name": "Dev SQL Server",
    "env": "DEV",
    "type": "mssql",
    "host": "localhost",
    "port": 1433,
    "database": "mydb",
    "username": "",
    "password": ""
  },
  {
    "id": "dev-mongo",
    "name": "Dev MongoDB",
    "env": "DEV",
    "type": "mongodb",
    "uri": "mongodb://localhost:27017/mydb"
  }
]'

# PHI Masking
PHI_ALWAYS_MASKED=true
PHI_ADMIN_CAN_UNMASK=true

# Branding
APP_NAME=D-Pilot
# Logo URL — local path (place file in public/) or external URL. Leave empty for text-only header.
LOGO_URL=/logo/logo.png
LIGHT_LOGO_URL=/logo/logo-light.png
FAVICON_URL=/logo/favicon.ico

# Email Domain (used for default admin seed and user creation validation)
EMAIL_DOMAIN=example.com

# Default admin password (used only when seeding the first admin user)
DEFAULT_ADMIN_PASSWORD=changeme123

# Query Safety
MAX_ROWS=10000
QUERY_TIMEOUT_MS=30000

# MCP endpoint (/api/mcp) — rows returned per AI-agent query; agents may raise per call
MCP_MAX_ROWS=1000

# Azure Open AI Creds
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_MODEL=gpt-4-32k
# Optional. Defaults to 2024-08-01-preview.
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Set true ONLY on networks with a TLS-inspecting proxy that re-signs HTTPS
# (causes "unable to get local issuer certificate"). Skips cert verification
# for the Azure call. Preferred secure alternative: point Node at the corporate
# root CA via NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem instead.
# AZURE_OPENAI_INSECURE_TLS=false
# How long (hours) to cache a connection's introspected schema for AI query
# generation. Schema rarely changes; caching avoids re-introspecting the DB on
# every request. Default 24. Set 0 to disable caching.
# SCHEMA_CACHE_TTL_HOURS=24
