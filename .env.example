# D-Pilot configuration. Copy to .env. Details: docs/environment-variables.md
# Connections and the AI assistant are configured in-app under Settings.

# --- Bootstrap (read only from here; restart to apply) ---

# Port the server listens on
PORT=3101
# Port of the Vite dev server (development only)
VITE_PORT=3100
# development | production
NODE_ENV=development
# Sub-path behind a shared-domain proxy; build and run must agree
# BASE_PATH=/d-pilot
# Folder for the app database and settings.key
# DATA_DIR=data
# Encrypts stored secrets; unset = key generated into DATA_DIR/settings.key
# SETTINGS_ENCRYPTION_KEY=
# Signs login tokens; use a long random string
JWT_SECRET=change-this-to-a-secure-random-string
# Password for the first admin, seeded into an empty database
DEFAULT_ADMIN_PASSWORD=changeme123
# Outbound proxy for the Azure OpenAI call
# HTTPS_PROXY=http://proxy.example:8080
# HTTP_PROXY=http://proxy.example:8080

# --- Ceilings: admins cannot set a limit above these (can only lower the built-in cap) ---

# Highest MAX_ROWS allowed
# MAX_ROWS_LIMIT=1000000
# Highest MCP_MAX_ROWS allowed
# MCP_MAX_ROWS_LIMIT=1000000
# Highest QUERY_TIMEOUT_MS allowed
# QUERY_TIMEOUT_MS_LIMIT=2147483647
# Highest SCHEMA_CACHE_TTL_HOURS allowed
# SCHEMA_CACHE_TTL_HOURS_LIMIT=8760

# --- Fallbacks (a value saved in Settings wins over these) ---

# App name in the header and page title
APP_NAME=D-Pilot
# Header logo for dark mode, path under public/ or URL (unset = text-only header)
# LOGO_URL=/logo/logo.png
# Header logo for light mode (unset = LOGO_URL)
# LIGHT_LOGO_URL=/logo/logo-light.png
# Browser tab icon
# FAVICON_URL=/favicon-32.png
# Required email domain for new users (unset = any domain)
EMAIL_DOMAIN=example.com
# Public origin for links in MCP output, without BASE_PATH (unset = relative links)
# APP_BASE_URL=https://d-pilot.example.com
# Session length for new logins (needs a unit: 24h, 7d)
JWT_EXPIRES_IN=24h
# Row cap for queries without their own limit
MAX_ROWS=10000
# Query timeout in milliseconds
QUERY_TIMEOUT_MS=90000
# Default rows per AI-agent query on /api/mcp
MCP_MAX_ROWS=1000
# Hours to cache a connection's schema (0 disables)
# SCHEMA_CACHE_TTL_HOURS=24
# Results "Copy as" formats as a JSON array (unset = the built-in formats; see docs)
# COPY_FORMATS=
