{
  "name": "d-pilot",
  "version": "1.16.0",
  "description": "D-Pilot — Internal SQL Explorer with PHI Masking",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "restart": "npm run dev",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "predev:local": "DOTENV_CONFIG_PATH=.env.dev node scripts/free-ports.mjs",
    "dev:local": "concurrently \"npm run dev:server:local\" \"npm run dev:client:local\"",
    "dev:server:local": "DOTENV_CONFIG_PATH=.env.dev tsx watch server/index.ts",
    "dev:client:local": "vite --mode dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "format": "prettier --write .",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@mantine/core": "^8.3.12",
    "@mantine/hooks": "^8.3.12",
    "@mantine/notifications": "^8.3.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.34.1",
    "ag-grid-community": "^35.2.0",
    "ag-grid-react": "^35.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.15",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "mongodb": "^4.17.2",
    "mssql": "^11.0.1",
    "pg": "^8.13.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-obj-view": "^1.1.10",
    "react-router-dom": "^7.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.7.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
